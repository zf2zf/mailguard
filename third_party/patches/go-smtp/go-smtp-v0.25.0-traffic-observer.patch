+// TrafficDirection identifies the direction of SMTP application bytes observed
+// at the protocol reader/writer boundary. These are plaintext bytes, including
+// SMTP commands, responses, and message transfer content. TLS ciphertext must
+// be captured separately at the underlying net.Conn boundary.
+type TrafficDirection string
+
+const (
+	TrafficClientToServer TrafficDirection = "client_to_server"
+	TrafficServerToClient TrafficDirection = "server_to_client"
+)
+
 // A SMTP server.
